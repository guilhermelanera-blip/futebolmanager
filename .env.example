DATABASE_URL="postgresql://usuario:senha@localhost:5432/futebol_manager?schema=public"
PORT=3000

# Tempo de vida da sessão de autenticação, em dias (18_SEGURANCA, seção 1).
# Opcional — padrão 30.
SESSAO_TTL_DIAS=30

# Segredo que o GitHub Actions envia (header x-cron-secret) para disparar o
# relógio da liga em produção (src/scheduler/cron.routes.ts). Gere um valor
# aleatório qualquer — ex.: `openssl rand -hex 24`.
CRON_SECRET=
