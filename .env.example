
# Runtime (consultas do app) — em produção, aponte para o POOLER do provedor
# gerenciado (ex.: Supabase "Transaction pooler", porta 6543, com
# ?pgbouncer=true), não para a conexão direta: a conexão direta some em
# ambiente serverless. Local/dev pode ser direto (ex.: localhost:5432).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/futebol_manager?schema=public"
# Só usada pelo `prisma migrate` (CLI, rodado do seu computador): conexão
# direta ao banco (porta 5432).
DIRECT_URL="postgresql://usuario:senha@localhost:5432/futebol_manager?schema=public"
PORT=3000

# Tempo de vida da sessão de autenticação, em dias (18_SEGURANCA, seção 1).
# Opcional — padrão 30.
SESSAO_TTL_DIAS=30

# Segredo que o GitHub Actions envia (header x-cron-secret) para disparar o
# relógio da liga em produção (src/scheduler/cron.routes.ts). Gere um valor
# aleatório qualquer — ex.: `openssl rand -hex 24`.
CRON_SECRET=
